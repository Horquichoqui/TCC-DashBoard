APP_NAME=Dashboard
APP_ENV=production
APP_KEY=base64:BWskfY9YT036Qrio94ikbH83MZbC7nAiAKxgbd0vZ+g=
APP_DEBUG=false
APP_URL=https://tcc-dashboard-backend.onrender.com

# Database Configuration - PostgreSQL NEON
DB_CONNECTION=pgsql
DB_HOST=ep-plain-sea-ac72oqv6-pooler.sa-east-1.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=npg_pB0T8dMWFGfK
DB_SSLMODE=require

# Logging
LOG_CHANNEL=single
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# Cache & Session
CACHE_DRIVER=file
CACHE_STORE=file
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# Queue & Broadcasting
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# Filesystem
FILESYSTEM_DISK=local

# Mail
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="dashboard@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# CORS
SANCTUM_STATEFUL_DOMAINS=tcc-dashboard-frontend.vercel.app,localhost:3000,localhost:5173
SESSION_DOMAIN=.onrender.com
SANCTUM_GUARD=web
